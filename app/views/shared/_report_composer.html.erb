<%# Report Composer Modal for AI-powered section composition %>
<%# Include this partial in report views where document composition is used %>

<div data-controller="report-composer" data-report-composer-report-id-value="<%= report.id %>">
  <button type="button" class="btn txt-medium" data-action="report-composer#open" title="AI Composer">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
    </svg>
    <span class="for-screen-reader">AI Composer</span>
  </button>

  <dialog class="composer" data-report-composer-target="dialog">
    <header class="composer__header">
      <h2 class="composer__title">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
        </svg>
        Document Composer
      </h2>
      <div class="composer__status" data-report-composer-target="status">Ready</div>
      <button type="button" class="composer__close" data-action="report-composer#close" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </header>

    <div class="composer__controls">
      <div class="composer__mode-switch" data-report-composer-target="modeSwitch">
        <label class="composer__mode-option">
          <input type="radio" name="composer-mode" value="ask" checked data-action="report-composer#switchMode">
          <span>Ask Question</span>
        </label>
        <label class="composer__mode-option">
          <input type="radio" name="composer-mode" value="compose" data-action="report-composer#switchMode">
          <span>Compose Section</span>
        </label>
      </div>

      <form class="composer__form" data-action="submit->report-composer#submit">
        <input
          type="text"
          class="composer__input"
          data-report-composer-target="input"
          placeholder="Ask a question about your documents (e.g., 'What is the maximum RAM capacity?')"
          autocomplete="off"
        >
        <button type="submit" class="composer__submit">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
          </svg>
          Submit
        </button>
      </form>
    </div>

    <div class="composer__body">
      <div class="composer__content" data-report-composer-target="content">
        <p class="composer__placeholder">Enter your question or topic above and click Submit to get AI-generated content from your documents.</p>
      </div>
    </div>

    <footer class="composer__footer">
      <button type="button" class="composer__btn composer__btn--ghost" data-action="report-composer#close">
        Close
      </button>
      <button type="button" class="composer__btn composer__btn--secondary" data-action="report-composer#copy" data-report-composer-target="copyButton" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
        </svg>
        Copy
      </button>
      <button type="button" class="composer__btn composer__btn--primary" data-action="report-composer#createPage" data-report-composer-target="createButton" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Create Page
      </button>
    </footer>
  </dialog>
</div>
