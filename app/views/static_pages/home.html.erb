<% content_for(:title) { "Dill - AI-Powered Due Diligence Reports" } %>

<section class="hero">
  <div class="hero__content">
    <h1 class="hero__title">
      Don't get in a pickle,<br>
      <span class="hero__highlight">do dill.</span>
    </h1>
    <p class="hero__subtitle">
      Due Diligence
    </p>
    <div class="hero__actions">
      <%= link_to "Get Started", new_session_path, class: "btn btn--reversed btn--large" %>
      <a href="#features" class="btn btn--large">Learn More</a>
    </div>
  </div>
  <div class="hero__visual">
    <div class="hero__mockup">
      <div class="mockup-window">
        <div class="mockup-header">
          <span class="mockup-dot"></span>
          <span class="mockup-dot"></span>
          <span class="mockup-dot"></span>
        </div>
        <div class="mockup-content">
          <div class="mockup-sidebar">
            <div class="mockup-item"></div>
            <div class="mockup-item mockup-item--active"></div>
            <div class="mockup-item"></div>
          </div>
          <div class="mockup-main">
            <div class="mockup-title"></div>
            <div class="mockup-text"></div>
            <div class="mockup-text mockup-text--short"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="feature-showcase">
  <div class="feature-showcase__header">
    <h2 class="feature-showcase__title">AI-Powered Document Composer</h2>
    <p class="feature-showcase__subtitle">Ask questions, compose sections, and generate content from your source documents with intelligent citations.</p>
  </div>

  <div class="feature-showcase__grid">
    <div class="feature-showcase__item">
      <div class="feature-showcase__image">
        <%= image_tag "feature-composer-modal.png", alt: "Document Composer modal interface", class: "feature-showcase__img" %>
      </div>
      <div class="feature-showcase__content">
        <h3 class="feature-showcase__item-title">Intuitive Modal Interface</h3>
        <p class="feature-showcase__item-description">
          Access the AI-powered Document Composer directly from your report. Choose between Ask Question mode for quick answers or Compose Section mode for generating full report sections.
        </p>
      </div>
    </div>

    <div class="feature-showcase__item feature-showcase__item--reversed">
      <div class="feature-showcase__image">
        <%= image_tag "feature-ask-question.png", alt: "Ask Question mode with AI response", class: "feature-showcase__img" %>
      </div>
      <div class="feature-showcase__content">
        <h3 class="feature-showcase__item-title">Ask Questions, Get Answers</h3>
        <p class="feature-showcase__item-description">
          Query your uploaded documents in natural language. The AI searches through your PDFs, presentations, and documents to provide accurate, contextual answers in real-time.
        </p>
      </div>
    </div>

    <div class="feature-showcase__item">
      <div class="feature-showcase__image">
        <%= image_tag "feature-sources-library.png", alt: "Source Library for managing research materials", class: "feature-showcase__img" %>
      </div>
      <div class="feature-showcase__content">
        <h3 class="feature-showcase__item-title">Source Library</h3>
        <p class="feature-showcase__item-description">
          Build a comprehensive source library from PDFs, URLs, images, and text. All your research materials in one place, ready for AI-powered analysis and citation.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="feature-showcase feature-showcase--alt">
  <div class="feature-showcase__header">
    <h2 class="feature-showcase__title">Professional Report Structure</h2>
    <p class="feature-showcase__subtitle">Organize your findings with pages, diagrams, and detailed findings.</p>
  </div>

  <div class="feature-showcase__grid">
    <div class="feature-showcase__item">
      <div class="feature-showcase__image">
        <%= image_tag "feature-report-toc.png", alt: "Report table of contents with section previews", class: "feature-showcase__img" %>
      </div>
      <div class="feature-showcase__content">
        <h3 class="feature-showcase__item-title">Visual Table of Contents</h3>
        <p class="feature-showcase__item-description">
          See your entire report at a glance with rich section previews. Drag and drop to reorganize, add new pages, pictures, and findings with one click.
        </p>
      </div>
    </div>

    <div class="feature-showcase__item feature-showcase__item--reversed">
      <div class="feature-showcase__image">
        <%= image_tag "feature-architecture-diagram.png", alt: "Technical architecture diagram", class: "feature-showcase__img" %>
      </div>
      <div class="feature-showcase__content">
        <h3 class="feature-showcase__item-title">Rich Visual Content</h3>
        <p class="feature-showcase__item-description">
          Include architecture diagrams, flowcharts, and images directly in your reports. Perfect for technical due diligence and visual explanations.
        </p>
      </div>
    </div>
  </div>
</section>

<section id="features" class="features">
  <div class="features__header">
    <h2 class="features__title">Everything you need for thorough research</h2>
    <p class="features__subtitle">Built for investment professionals who value depth and accuracy.</p>
  </div>

  <div class="features__grid">
    <div class="feature">
      <div class="feature__icon">📄</div>
      <h3 class="feature__title">Smart Document Analysis</h3>
      <p class="feature__description">
        Upload financial statements, pitch decks, and contracts. Our AI extracts key insights and flags potential concerns automatically.
      </p>
    </div>

    <div class="feature">
      <div class="feature__icon">🤖</div>
      <h3 class="feature__title">AI Writing Assistant</h3>
      <p class="feature__description">
        Generate professional report sections, improve your writing, and ensure consistency across your entire due diligence process.
      </p>
    </div>

    <div class="feature">
      <div class="feature__icon">📊</div>
      <h3 class="feature__title">Structured Reports</h3>
      <p class="feature__description">
        Organize findings into chapters, sections, and findings. Create comprehensive reports that tell a complete investment story.
      </p>
    </div>

    <div class="feature">
      <div class="feature__icon">🔗</div>
      <h3 class="feature__title">Source Management</h3>
      <p class="feature__description">
        Track every claim back to its source. Keep your research organized and your conclusions defensible.
      </p>
    </div>

    <div class="feature">
      <div class="feature__icon">👥</div>
      <h3 class="feature__title">Team Collaboration</h3>
      <p class="feature__description">
        Work together seamlessly with shared reports, real-time updates, and clear ownership of each section.
      </p>
    </div>

    <div class="feature">
      <div class="feature__icon">📤</div>
      <h3 class="feature__title">Easy Publishing</h3>
      <p class="feature__description">
        Share reports internally or externally with beautiful, professional formatting ready for stakeholder review.
      </p>
    </div>
  </div>
</section>

<section class="cta">
  <div class="cta__content">
    <h2 class="cta__title">Ready to streamline your due diligence?</h2>
    <p class="cta__subtitle">Start creating better reports today.</p>
    <%= link_to "Get Started Free", new_session_path, class: "btn btn--reversed btn--large" %>
  </div>
</section>
