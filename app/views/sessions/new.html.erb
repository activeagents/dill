<% content_for(:title) { "Sign in" } %>
<% turbo_page_requires_reload %>

<div class="panel shadow center margin-block-double <%= "shake" if flash[:alert] %>">
  <span class="product__logo center" style="font-size: 100px;">🥒</span>
  <h1 class="margin-none-block-start margin-block-end-double">Dill</h1>

  <% if flash[:alert] %>
    <p class="txt-warning margin-block-end"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: session_path, class: "stack" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "current-password" %>
    </div>

    <%= form.submit "Sign in", class: "btn" %>
  <% end %>

  <div class="txt-align-center margin-block txt-subtle">or</div>

  <%= button_to "/auth/google_oauth2", method: :post, class: "btn btn--reversed center gap", data: { turbo: false } do %>
    <%= image_tag "https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg", size: 24, alt: "Google logo" %>
    <span>Sign in with Google</span>
  <% end %>
</div>

<% content_for(:footer) do %>
  <div class="txt-align-center center margin-block-double txt-subtle">Dill version <%= version_badge %></div>
<% end %>
