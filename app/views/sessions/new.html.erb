<% content_for(:title) { "Sign in" } %>
<% turbo_page_requires_reload %>

<div class="panel shadow center margin-block-double <%= "shake" if flash[:alert] %>">
  <div class="txt-align-center margin-block-end">
    <div style="font-size: 4rem; line-height: 1;">🥒</div>
    <h1 class="margin-none txt-x-large">Dill</h1>
  </div>

  <% if flash[:alert] %>
    <p class="txt-warning txt-align-center margin-block-end"><%= flash[:alert] %></p>
  <% end %>

  <% if flash[:notice] %>
    <p class="txt-align-center margin-block-end" style="color: var(--color-positive);"><%= flash[:notice] %></p>
  <% end %>

  <%= button_to "/auth/google_oauth2", method: :post, class: "btn btn--reversed full-width gap margin-block-end", data: { turbo: false } do %>
    <%= image_tag "https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg", size: 20, alt: "Google logo", style: "filter: none;" %>
    <span>Continue with Google</span>
  <% end %>

  <div class="divider margin-block">
    <span class="txt-small">or sign in with email</span>
  </div>

  <%= form_with url: session_path, class: "stack" do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", class: "input" %>
    </div>

    <div class="field">
      <%= form.label :password, "Password" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", class: "input" %>
    </div>

    <%= form.submit "Sign in", class: "btn btn--reversed full-width" %>
  <% end %>
</div>

<% content_for(:footer) do %>
  <div class="txt-align-center center margin-block-double txt-subtle txt-small">Dill version <%= version_badge %></div>
<% end %>
