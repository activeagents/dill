<!DOCTYPE html>
<html>
  <head>
    <title>~*~DiLLdotVC~*~ HELLA TOKENS 4 HELLA CHEAP!!!</title>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="BEST AI TOKENS ON THE WEB!!! Click here for AMAZING deals!!!">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <style>
      @import url('https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&display=swap');

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Comic Neue', 'Comic Sans MS', cursive;
        background: linear-gradient(180deg, #000080 0%, #000040 50%, #800080 100%);
        background-attachment: fixed;
        min-height: 100vh;
        color: #00ff00;
        cursor: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32'><text y='24' font-size='24'>🥒</text></svg>"), auto;
      }

      /* Starfield background */
      body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image:
          radial-gradient(2px 2px at 20px 30px, white, transparent),
          radial-gradient(2px 2px at 40px 70px, white, transparent),
          radial-gradient(1px 1px at 90px 40px, white, transparent),
          radial-gradient(2px 2px at 160px 120px, white, transparent),
          radial-gradient(1px 1px at 230px 80px, white, transparent),
          radial-gradient(2px 2px at 300px 150px, white, transparent),
          radial-gradient(1px 1px at 400px 60px, white, transparent),
          radial-gradient(2px 2px at 500px 200px, white, transparent),
          radial-gradient(1px 1px at 600px 90px, white, transparent),
          radial-gradient(2px 2px at 700px 180px, white, transparent);
        background-size: 800px 300px;
        animation: twinkle 4s ease-in-out infinite;
        pointer-events: none;
        z-index: -1;
      }

      @keyframes twinkle {
        0%, 100% { opacity: 0.5; }
        50% { opacity: 1; }
      }

      .construction-banner {
        background: repeating-linear-gradient(
          45deg,
          #ffff00,
          #ffff00 10px,
          #000000 10px,
          #000000 20px
        );
        padding: 8px;
        text-align: center;
      }

      .construction-banner span {
        background: #ff0000;
        color: white;
        padding: 4px 12px;
        font-weight: bold;
        text-transform: uppercase;
        animation: blink 0.5s infinite;
      }

      @keyframes blink {
        50% { opacity: 0; }
      }

      .marquee-container {
        background: linear-gradient(90deg, #ff00ff, #00ffff, #ffff00, #ff00ff);
        padding: 4px 0;
        overflow: hidden;
      }

      .marquee {
        display: flex;
        animation: marquee 20s linear infinite;
        white-space: nowrap;
      }

      .marquee span {
        padding: 0 50px;
        font-size: 18px;
        font-weight: bold;
        color: #000;
        text-shadow: 1px 1px 0 white;
      }

      @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      .retro-header {
        background: linear-gradient(180deg, #c0c0c0 0%, #808080 100%);
        border-bottom: 3px outset #ffffff;
        padding: 10px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .retro-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
      }

      .retro-logo__icon {
        font-size: 48px;
        animation: bounce 0.5s infinite alternate;
      }

      @keyframes bounce {
        from { transform: translateY(0); }
        to { transform: translateY(-5px); }
      }

      .retro-logo__text {
        font-size: 36px;
        font-weight: bold;
        background: linear-gradient(180deg, #ff0000, #ff8800, #ffff00, #00ff00, #0088ff, #ff00ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: 2px 2px 0 rgba(0,0,0,0.3);
        font-family: Impact, sans-serif;
      }

      .hit-counter {
        background: #000;
        border: 2px inset #808080;
        padding: 4px 8px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .hit-counter__label {
        color: #00ff00;
        font-size: 10px;
      }

      .hit-counter__digits {
        font-family: 'Courier New', monospace;
        background: #001100;
        color: #00ff00;
        padding: 2px 6px;
        border: 1px inset #004400;
        letter-spacing: 2px;
      }

      .main-content {
        max-width: 900px;
        margin: 20px auto;
        padding: 0 20px;
      }

      .hero-box {
        background: linear-gradient(135deg, #000080, #0000c0);
        border: 4px outset #4040ff;
        padding: 30px;
        text-align: center;
        margin-bottom: 20px;
        position: relative;
      }

      .hero-box::before {
        content: '~ * ~ * ~';
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        color: #ffff00;
        font-size: 12px;
        letter-spacing: 4px;
      }

      .hero-title {
        font-size: 48px;
        color: #ffff00;
        text-shadow:
          3px 3px 0 #ff0000,
          -1px -1px 0 #00ffff;
        margin-bottom: 10px;
        font-family: Impact, sans-serif;
        animation: glow 1s ease-in-out infinite alternate;
      }

      @keyframes glow {
        from { text-shadow: 3px 3px 0 #ff0000, -1px -1px 0 #00ffff, 0 0 10px #ffff00; }
        to { text-shadow: 3px 3px 0 #ff0000, -1px -1px 0 #00ffff, 0 0 30px #ffff00; }
      }

      .hero-subtitle {
        font-size: 24px;
        color: #00ff00;
        margin-bottom: 20px;
      }

      .hero-tagline {
        font-size: 32px;
        color: #ff00ff;
        animation: rainbow 2s linear infinite;
        font-weight: bold;
      }

      @keyframes rainbow {
        0% { color: #ff0000; }
        17% { color: #ff8800; }
        33% { color: #ffff00; }
        50% { color: #00ff00; }
        67% { color: #0088ff; }
        83% { color: #ff00ff; }
        100% { color: #ff0000; }
      }

      .price-burst {
        position: relative;
        display: inline-block;
        margin: 30px 0;
      }

      .price-burst__bg {
        width: 250px;
        height: 250px;
        background: linear-gradient(45deg, #ff0000, #ff8800);
        clip-path: polygon(
          50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%,
          50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%
        );
        display: flex;
        align-items: center;
        justify-content: center;
        animation: spin 10s linear infinite;
      }

      @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      .price-burst__content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        z-index: 10;
      }

      .price-burst__label {
        font-size: 14px;
        color: #ffff00;
        font-weight: bold;
      }

      .price-burst__price {
        font-size: 42px;
        color: #ffffff;
        font-weight: bold;
        font-family: Impact, sans-serif;
        text-shadow: 2px 2px 0 #000;
      }

      .price-burst__unit {
        font-size: 12px;
        color: #ffff00;
      }

      .cta-button {
        display: inline-block;
        background: linear-gradient(180deg, #00ff00 0%, #008800 100%);
        border: 4px outset #00ff00;
        color: #000;
        font-size: 24px;
        font-weight: bold;
        padding: 15px 40px;
        text-decoration: none;
        text-transform: uppercase;
        cursor: pointer;
        animation: pulse 0.5s ease-in-out infinite alternate;
        font-family: Impact, sans-serif;
        letter-spacing: 2px;
      }

      .cta-button:hover {
        background: linear-gradient(180deg, #ffff00 0%, #ff8800 100%);
        border-color: #ffff00;
      }

      .cta-button:active {
        border-style: inset;
      }

      @keyframes pulse {
        from { transform: scale(1); }
        to { transform: scale(1.05); }
      }

      .features-table {
        background: #c0c0c0;
        border: 3px outset #ffffff;
        margin: 20px 0;
      }

      .features-table__header {
        background: linear-gradient(180deg, #000080, #0000c0);
        color: white;
        padding: 10px;
        font-size: 20px;
        font-weight: bold;
        text-align: center;
        border-bottom: 2px solid #000;
      }

      .features-table__body {
        padding: 15px;
      }

      .feature-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px;
        border-bottom: 1px dotted #808080;
        color: #000;
      }

      .feature-row:last-child {
        border-bottom: none;
      }

      .feature-row__icon {
        font-size: 24px;
        min-width: 30px;
      }

      .feature-row__check {
        color: #00aa00;
        font-weight: bold;
        font-size: 18px;
      }

      .feature-row__text {
        flex: 1;
        font-size: 16px;
      }

      .testimonials {
        background: #ffffcc;
        border: 3px double #cc9900;
        padding: 20px;
        margin: 20px 0;
      }

      .testimonials__title {
        text-align: center;
        color: #cc0000;
        font-size: 24px;
        margin-bottom: 15px;
        text-decoration: underline;
      }

      .testimonial {
        background: white;
        border: 1px solid #999;
        padding: 10px;
        margin: 10px 0;
        font-style: italic;
        color: #333;
      }

      .testimonial__author {
        text-align: right;
        font-style: normal;
        font-weight: bold;
        color: #000080;
      }

      .guestbook-link {
        text-align: center;
        margin: 20px 0;
      }

      .guestbook-link a {
        color: #00ffff;
        font-size: 18px;
      }

      .under-construction {
        text-align: center;
        margin: 20px 0;
        font-size: 14px;
        color: #ffff00;
      }

      .under-construction span {
        display: inline-block;
        animation: shake 0.2s infinite;
      }

      @keyframes shake {
        0%, 100% { transform: rotate(-2deg); }
        50% { transform: rotate(2deg); }
      }

      .webring {
        background: #808080;
        border: 2px inset #c0c0c0;
        padding: 10px;
        text-align: center;
        margin: 20px 0;
        color: white;
        font-size: 12px;
      }

      .webring a {
        color: #00ffff;
      }

      .retro-footer {
        background: #000;
        border-top: 3px ridge #808080;
        padding: 20px;
        text-align: center;
        color: #00ff00;
        font-size: 12px;
      }

      .retro-footer__badges {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 15px;
        flex-wrap: wrap;
      }

      .badge {
        background: #333;
        border: 1px solid #666;
        padding: 4px 8px;
        font-size: 10px;
        color: #fff;
      }

      .email-link {
        color: #00ffff;
        text-decoration: underline;
      }

      /* Fire text effect */
      .fire-text {
        background: linear-gradient(180deg,
          #ffff00 0%,
          #ff8800 30%,
          #ff0000 60%,
          #880000 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        font-weight: bold;
      }

      .sparkle {
        display: inline-block;
        animation: sparkle 0.5s ease-in-out infinite;
      }

      @keyframes sparkle {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(1.2); }
      }

      .new-badge {
        display: inline-block;
        background: #ff0000;
        color: #ffff00;
        font-size: 10px;
        padding: 2px 6px;
        font-weight: bold;
        animation: blink 0.5s infinite;
        vertical-align: super;
      }

      .cool-divider {
        text-align: center;
        color: #00ffff;
        margin: 20px 0;
        font-size: 14px;
        letter-spacing: 4px;
      }
    </style>
  </head>

  <body>
    <div class="construction-banner">
