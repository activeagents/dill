<% content_for(:title) { "Set up Dill" } %>

<div class="panel shadow center margin-block-double">
  <span class="product__logo center" style="font-size: 100px;">🥒</span>
  <h1 class="margin-none-block-start margin-block-end">Set up Dill</h1>
  <p class="txt-subtle margin-block-end-double">Sign in with Google to create your admin account</p>

  <%= button_to "/auth/google_oauth2", method: :post, class: "btn btn--reversed center gap", data: { turbo: false } do %>
    <%= image_tag "https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg", size: 24, alt: "Google logo" %>
    <span>Sign in with Google</span>
  <% end %>
</div>
