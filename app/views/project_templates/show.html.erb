<% content_for(:title) { @project_template.name } %>

<% content_for :header do %>
  <nav>
    <%= link_to project_templates_path, class: "btn flex-item-justify-start" do %>
      <%= image_tag "arrow-left.svg", aria: { hidden: true }, size: 24 %>
      <span class="for-screen-reader">Back to templates</span>
    <% end %>

    <span class="txt-large center"><%= @project_template.name %></span>

    <% if @project_template.created_by == Current.user %>
      <%= link_to edit_project_template_path(@project_template), class: "btn" do %>
        <%= image_tag "pencil.svg", aria: { hidden: true }, size: 24 %>
        <span class="for-screen-reader">Edit template</span>
      <% end %>
    <% else %>
      <span class="btn btn--placeholder" aria-hidden="true"></span>
    <% end %>
  </nav>
<% end %>

<div class="container pad">
  <div class="stack gap-lg">
    <section>
      <% if @project_template.description.present? %>
        <p class="txt-subtle margin-block-end"><%= @project_template.description %></p>
      <% end %>

      <div class="flex gap-sm margin-block-end">
        <span class="badge" data-theme="<%= @project_template.theme %>"><%= @project_template.theme.capitalize %></span>
        <% if @project_template.shared? %>
          <span class="badge badge--subtle">Shared with team</span>
        <% else %>
          <span class="badge badge--subtle">Private</span>
        <% end %>
      </div>
    </section>

    <% if @project_template.ai_instructions.present? %>
      <section>
        <h2 class="txt-medium margin-block-end">AI Instructions</h2>
        <div class="prose txt-small"><%= simple_format(@project_template.ai_instructions) %></div>
      </section>
    <% end %>

    <section>
      <h2 class="txt-medium margin-block-end">Sections (<%= @project_template.section_schema.size %>)</h2>
      <div class="stack gap-md">
        <% @project_template.section_schema.each_with_index do |section, index| %>
          <div class="section-preview">
            <div class="flex gap-sm align-center margin-block-end-sm">
              <span class="txt-subtle"><%= index + 1 %>.</span>
              <strong><%= section["title"] %></strong>
              <span class="badge badge--small"><%= section["type"] %></span>
              <% if section["required"] %>
                <span class="txt-subtle txt-small">Required</span>
              <% end %>
            </div>
            <% if section["instructions"].present? %>
              <p class="txt-small txt-subtle"><%= truncate(section["instructions"], length: 200) %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>

    <section class="flex gap-sm">
      <%= button_to "Create Report from Template", create_report_project_template_path(@project_template),
          class: "btn btn--reversed",
          data: { turbo_confirm: "Create a new report from this template?" } %>

      <% if @project_template.created_by == Current.user %>
        <%= link_to "Edit Template", edit_project_template_path(@project_template), class: "btn" %>
        <%= button_to "Delete", @project_template, method: :delete,
            class: "btn btn--danger",
            data: { turbo_confirm: "Are you sure you want to delete this template?" } %>
      <% end %>
    </section>
  </div>
</div>
