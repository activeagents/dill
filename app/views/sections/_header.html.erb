<% content_for :header do %>
  <%= section_nav_tag(section) do %>
    <%= render "sections/sidebar_toggle" %>

    <%= link_to_previous_sectionable(section) %>

    <div class="breadcrumbs">
      <%= render "reports/index_link" %>
      <span class="flex-item-no-shrink">▸</span>
      <%= link_to report.title, report_slug_path(report) %>
      <span class="flex-item-no-shrink">▸</span>
      <strong><%= section.sectionable.title %></strong>
    </div>

    <button class="btn" data-action="fullscreen#toggle" data-fullscreen-target="button">
      <%= image_tag "expand.svg", aria: { hidden: true }, size: 24 %>
      <span class="for-screen-reader">Enter fullscreen</span>
    </button>

    <%= render "reports/searches/search", report: @report %>
  <% end %>
<% end %>

<% content_for :toolbar do %>
  <div class="flex flex-column">
    <div class="page-toolbar fill-shade flex align-center justify-between">
      <% if report.editable? %>
        <%= editing_mode_toggle_switch(@section, checked: false) %>
      <% else %>
        <span></span>
      <% end %>

      <%# References toggle button for pages with research sources %>
      <% if section.page? && section.page.has_research_references? %>
        <button type="button"
                class="btn flex references-toggle txt-small"
                onclick="document.dispatchEvent(new CustomEvent('references-panel:toggle'))"
                title="Research Sources (<%= section.page.research_references.count %>)">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="20" height="20">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
          </svg>
          <span class="references-toggle__badge"><%= section.page.research_references.count %></span>
          <span class="for-screen-reader">Research Sources</span>
        </button>
      <% end %>
    </div>

    <%= render "reports/searches/banner" %>
  </div>
<% end %>
